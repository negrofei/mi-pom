# MySQL SMN (intranet) — fuente primaria METAR/SPECI/SYNOP
# Soporta prefijos SMN_ o DMA_ (compatibilidad)
SMN_MYSQL_HOST=10.10.100.121
SMN_MYSQL_PORT=3306
SMN_MYSQL_USER=
SMN_MYSQL_PASSWORD=
SMN_MYSQL_DATABASE=mensajes
SMN_MYSQL_CONNECT_TIMEOUT=5
# El servidor SMN no ofrece TLS (dejar en 0)
SMN_MYSQL_SSL=0

# Sin fallback: si está en 1, no consulta OGIMET ni AviationWeather
# (solo usa datos del SMN; si no hay conexión, queda vacío)
SMN_ONLY=0

# Contingencia AviationWeather / OGIMET (1 = fallback si DMA falla)
CONTINGENCY_ENABLED=1

# Tablas (defaults)
# SMN_TABLE_METAR=metar_obs
# SMN_TABLE_SPECI=speci_obs
# SMN_TABLE_SYNOP=synop_obs
# SMN_TABLE_TAF=taf_obs
